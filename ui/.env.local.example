# REGDOCS Atlas server-side Azure AI Search configuration.
AZURE_SEARCH_ENDPOINT=https://<service-name>.search.windows.net
AZURE_SEARCH_INDEX=regdocs-chunks-hybrid

# Required to enable hybrid keyword + vector retrieval. The names must match
# the versioned index created by tools/publish_hybrid_index.py.
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_SEMANTIC_CONFIGURATION=regdocs-semantic

# Optional for local development. Use a read-only query key, never an admin key.
# In Azure App Service, omit this setting and use the managed identity instead.
# Never expose the key through a NEXT_PUBLIC_* variable.
AZURE_SEARCH_API_KEY=<query-key>

# Microsoft Foundry project and deployed chat model used by POST /api/ask.
# Authentication uses DefaultAzureCredential; no model key is sent to the browser.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=<chat-model-deployment-name>
