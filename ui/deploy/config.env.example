# Copy this file to config.env and replace every REPLACE value.
# Never save the SAS token here; export AZURE_STORAGE_SAS_TOKEN in Cloud Shell.

# Azure subscription and new deployment
SUBSCRIPTION_ID="REPLACE-WITH-SUBSCRIPTION-ID"
RESOURCE_GROUP="rg-regdocs-atlas"
LOCATION="eastus2"
SEARCH_LOCATION="eastus2"
FOUNDRY_LOCATION="eastus2"

# Unique suffix for global names (3-12 lowercase letters/digits), for example
# jv202608. The script derives Search, Foundry, ACR, UI, and job names from it.
NAME_SUFFIX="REPLACE"

# Existing Storage account. Terraform references its resource ID for RBAC but
# never imports, creates, changes, or deletes it. It can remain Canada Central.
STORAGE_ACCOUNT="REPLACE"
# Leave blank when Storage is in SUBSCRIPTION_ID.
STORAGE_SUBSCRIPTION_ID=""
STORAGE_RESOURCE_GROUP="REPLACE"
BLOB_CONTAINER="REPLACE"
NORMALIZED_BLOB_PREFIX="workspace/4_normalize"
EMBEDDING_CACHE_BLOB="workspace/5_index/embedding-cache.sqlite"

# Terraform state is stored in the same existing container. The SAS requires
# read, create, write, and list permissions for state and Blob lease locking.
STATE_BLOB="terraform/regdocs-atlas.tfstate"

# Search defaults. Standard Search is the main fixed monthly cost.
SEARCH_SKU="standard"
SEARCH_PARTITIONS="1"
SEARCH_REPLICAS="1"
SEARCH_SEMANTIC_PLAN="free"
SEARCH_INDEX="regdocs-chunks-hybrid"
SEARCH_VECTOR_FIELD="content_vector"
SEARCH_SEMANTIC_CONFIGURATION="regdocs-semantic"

# Foundry. Capacity is in thousands of TPM: 1000 = 1,000,000 TPM.
# GlobalStandard avoids the Canada Central Standard SKU limitation and is
# suitable for this public CER corpus. Change to DataZoneStandard if policy
# requires inference to remain within the United States data zone.
EMBEDDING_DEPLOYMENT="regdocs-embedding-3-small"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_MODEL_VERSION="1"
EMBEDDING_SKU="GlobalStandard"
EMBEDDING_CAPACITY="1000"
EMBEDDING_DIMENSIONS="1536"
EMBEDDING_BATCH_SIZE="128"
SEARCH_UPLOAD_BATCH_SIZE="1000"

CHAT_DEPLOYMENT="regdocs-chat"
CHAT_MODEL="gpt-4.1-mini"
CHAT_MODEL_VERSION="2025-04-14"
CHAT_SKU="GlobalStandard"
CHAT_CAPACITY="10"

# Set false to create the job without starting it. The script never starts a
# duplicate while an execution is running and reuses a successful execution.
START_INDEX_JOB="true"

# Required acknowledgement that Search, Foundry, ACR, logs, and Container Apps
# can incur Azure charges.
CONFIRM_BILLABLE_DEPLOYMENT="REPLACE-WITH-yes"
