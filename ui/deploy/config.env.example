# Copy this file to config.env and replace every REPLACE value.
# Never save the SAS token here; export AZURE_STORAGE_SAS_TOKEN in Cloud Shell.

# Azure subscription and new deployment
SUBSCRIPTION_ID="REPLACE-WITH-SUBSCRIPTION-ID"
RESOURCE_GROUP="rg-regdocs-atlas"
LOCATION="eastus2"
SEARCH_LOCATION="eastus2"
FOUNDRY_LOCATION="eastus2"

# Stable suffix for globally named Azure resources (3-12 lowercase letters/digits),
# for example jv202608. Pick it once and keep reusing it with the same remote
# Terraform state; normal updates do not require a new suffix.
NAME_SUFFIX="REPLACE"

# Existing Storage account. Terraform references its resource ID for RBAC but
# never imports, creates, changes, or deletes it. It can remain Canada Central.
STORAGE_ACCOUNT="REPLACE"
# Leave blank when Storage is in SUBSCRIPTION_ID.
STORAGE_SUBSCRIPTION_ID=""
STORAGE_RESOURCE_GROUP="REPLACE"
BLOB_CONTAINER="REPLACE"
NORMALIZED_BLOB_PREFIX="workspace/4_normalize"
EMBEDDING_CACHE_BLOB="workspace/5_index/embedding-cache.sqlite"

# Terraform state is stored in the same existing container. The SAS requires
# read, create, write, and list permissions for state and Blob lease locking.
STATE_BLOB="terraform/regdocs-atlas.tfstate"

# Search defaults. Standard Search is the main fixed monthly cost.
SEARCH_SKU="standard"
SEARCH_PARTITIONS="1"
SEARCH_REPLICAS="1"
SEARCH_SEMANTIC_PLAN="free"
SEARCH_INDEX="regdocs-chunks-hybrid"
SEARCH_VECTOR_FIELD="content_vector"
SEARCH_SEMANTIC_CONFIGURATION="regdocs-semantic"

# Optional IPv4 allowlist for the UI and all of its /api routes. Use /32 for a
# single public IP. An empty list leaves the app public. Keep the outer single
# quotes so Terraform receives the value as a list.
UI_ALLOWED_IP_CIDRS='[]'
# UI_ALLOWED_IP_CIDRS='["203.0.113.10/32","198.51.100.0/24"]'

# Foundry. Capacity is in thousands of TPM: 1000 = 1,000,000 TPM.
EMBEDDING_DEPLOYMENT="regdocs-embedding-3-small"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_MODEL_VERSION="1"
EMBEDDING_SKU="GlobalStandard"
EMBEDDING_CAPACITY="1000"
EMBEDDING_DIMENSIONS="1536"
# Keep this at 32 unless a tested change proves a larger request batch is safe.
EMBEDDING_BATCH_SIZE="32"
SEARCH_UPLOAD_BATCH_SIZE="1000"

CHAT_DEPLOYMENT="regdocs-chat"
CHAT_MODEL="gpt-4.1-mini"
CHAT_MODEL_VERSION="2025-04-14"
CHAT_SKU="GlobalStandard"
CHAT_CAPACITY="10"

# Stage 6 Foundry extraction. Empty means the full normalized corpus. For the
# first production check, set 10 (or another small number), deploy, run
# --restart-intelligence, verify the outputs, then clear this and run again.
# The extraction SQLite cache is stored in Blob and completed requests are reused.
INTELLIGENCE_DOCUMENT_LIMIT=""
export TF_VAR_intelligence_document_limit="$INTELLIGENCE_DOCUMENT_LIMIT"

# Deployment behavior is selected explicitly on the deploy.sh command line:
#   --validate              local Bash/Terraform/Python/Next.js checks; no Azure
#   --plan                  Terraform plan against remote state; no apply
#   --ui-only               update UI/API without starting Stage 5 or Stage 6
#   --infra-only            reconcile Terraform/RBAC/config without builds/jobs
#   --restart-index         force a Stage 5 hybrid-index execution
#   --restart-intelligence  start resumable Stage 6 Foundry extraction/publication
#   --status                read-only UI + Stage 5/6 status and recent logs
#   --error ID              read-only Log Analytics lookup for an ATLAS-... ID

# Required acknowledgement that Search, Foundry, ACR, logs, and Container Apps
# can incur Azure charges.
CONFIRM_BILLABLE_DEPLOYMENT="REPLACE-WITH-yes"
