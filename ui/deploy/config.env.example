# Copy this file to config.env and edit every value marked REPLACE.
# Do not put the SAS token here. Export AZURE_STORAGE_SAS_TOKEN in Cloud Shell.

# Azure scope and naming
SUBSCRIPTION_ID="REPLACE-WITH-SUBSCRIPTION-ID"
LOCATION="eastus2"
# Optional per-resource overrides. Leave blank to use LOCATION. The existing
# Storage account is addressed independently below and can remain in another
# region or resource group.
RESOURCE_GROUP_LOCATION=""
SEARCH_LOCATION=""
FOUNDRY_LOCATION=""
APP_SERVICE_LOCATION=""
RESOURCE_GROUP="rg-regdocs-atlas"
SEARCH_SERVICE="srch-regdocs-atlas-REPLACE"
FOUNDRY_ACCOUNT="aif-regdocs-atlas-REPLACE"
FOUNDRY_PROJECT="regdocs-atlas"
APP_SERVICE_PLAN="plan-regdocs-atlas"
WEB_APP="app-regdocs-atlas-REPLACE"

# Existing private Blob Storage created before this script runs. The same
# container supplies workspace/database and stores the cache and deployable ZIP.
STORAGE_ACCOUNT="stregdocsatlasREPLACE"
BLOB_CONTAINER="regdocs-deployment"
# Leave blank for Azure public cloud; otherwise supply the Blob service endpoint.
STORAGE_BLOB_ENDPOINT=""
NORMALIZED_BLOB_PREFIX="workspace/4_normalize"
DATABASE_BLOB="database/regdocs.db"
EMBEDDING_CACHE_BLOB="workspace/5_index/embedding-cache.sqlite"
UI_PACKAGE_BLOB="deploy/regdocs-atlas-ui.zip"
REQUIRE_DATABASE_BLOB="true"

# Azure AI Search
SEARCH_SKU="standard"
SEARCH_PARTITIONS="1"
SEARCH_REPLICAS="1"
SEARCH_SEMANTIC_PLAN="free"
SEARCH_INDEX="regdocs-chunks-hybrid"
SEARCH_VECTOR_FIELD="content_vector"
SEARCH_SEMANTIC_CONFIGURATION="regdocs-semantic"

# Foundry model deployments. Model availability and quota vary by region and
# subscription. Change the version, SKU, or capacity here when Azure reports
# that the configured offer is unavailable.
EMBEDDING_DEPLOYMENT="regdocs-embedding-3-small"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_MODEL_VERSION="1"
EMBEDDING_SKU="Standard"
EMBEDDING_CAPACITY="30"
EMBEDDING_DIMENSIONS="1536"
CHAT_DEPLOYMENT="regdocs-chat"
CHAT_MODEL="gpt-4.1-mini"
CHAT_MODEL_VERSION="2025-04-14"
CHAT_SKU="GlobalStandard"
CHAT_CAPACITY="10"

# App Service
APP_SERVICE_SKU="B1"
NODE_RUNTIME="NODE:24-lts"

# Deployment actions. A blank PUBLISH_LIMIT publishes the complete corpus;
# set it to 100 for a pilot. RECREATE_INDEX is destructive and is off by default.
PUBLISH_INDEX="true"
PUBLISH_LIMIT=""
RECREATE_INDEX="false"
DEPLOY_UI="true"

# Optional when `az ad signed-in-user show` is blocked by tenant policy.
DEPLOYER_OBJECT_ID=""
DEPLOYER_PRINCIPAL_TYPE="User"

# Required safety acknowledgement: provisioning creates billable Azure resources.
CONFIRM_BILLABLE_DEPLOYMENT="REPLACE-WITH-yes"
